rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.uploadCount == 0
        && request.resource.data.approvedCount == 0;

      allow update: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.approvedCount == resource.data.approvedCount
      );

      allow delete: if false;
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /academicYears/{yearId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /papers/{paperId} {
      // Papers are readable by all users
      allow read: if true;

      // Anyone authenticated (or submitting papers) can create a pending paper document
      allow create: if true;

      // Admins can update anything; users can update download counts or their pending papers
      allow update: if true;

      allow delete: if isAdmin() || (isSignedIn() && resource.data.uploadedBy == request.auth.uid);

      match /chunks/{chunkId} {
        allow read, write, create, update: if true;
      }
    }
  }
}
