# Pin behavior: package.json uses exact (no ^ / ~) versions on purpose.
# `npm audit fix --force` ignores semver ranges entirely and will happily
# jump major versions (this is what bumped Vite 5 -> 8 previously and
# broke the build). Avoid it. To check for vulnerabilities safely:
#
#   npm audit                # report only, makes no changes
#   npm update <package>     # bump one package deliberately, then test
#
# If you do need to fix an advisory, update that one package by hand in
# package.json, run `npm install`, then `npm run build && npm run lint`
# before committing.
save-exact=true
audit=false
