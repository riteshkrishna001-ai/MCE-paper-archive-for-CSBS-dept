rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.uploadCount == 0
        && request.resource.data.approvedCount == 0;

      allow update: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.uploadCount == resource.data.uploadCount &&
        request.resource.data.approvedCount == resource.data.approvedCount
      );

      allow delete: if false;
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /academicYears/{yearId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /papers/{paperId} {
      // Approved papers are public; pending/rejected papers are only visible to uploader and admins
      allow read: if resource == null 
        || resource.data.status == 'approved'
        || (isSignedIn() && resource.data.uploadedBy == request.auth.uid)
        || isAdmin();

      // Signed in users can submit a pending paper
      allow create: if isSignedIn()
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.downloadCount == 0;

      // Admins can update anything.
      // Anyone can increment the download count.
      allow update: if isAdmin()
        || (isSignedIn() && request.resource.data.uploadedBy == request.auth.uid 
            && resource.data.status == 'pending' 
            && request.resource.data.status == 'pending')
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount']));

      allow delete: if isAdmin() || (isSignedIn() && resource.data.uploadedBy == request.auth.uid && resource.data.status == 'pending');
    }
  }
}
